# Go build artifacts
bin/
dist/
*.test
*.out
*.prof
coverage.*

# Go module cache (none here; pulled by `go mod download`)
vendor/

# Editor / IDE
.idea/
.vscode/
.run/
*.iml
*.swp
*.swo

# Direnv / nix
.direnv/
.envrc
result
result-*

# OS junk
.DS_Store
Thumbs.db

# Local secrets / cluster config
kubeconfig
.kube/
*.env
.env.*
!.env.example
*.pem
*.key

# Legacy Groovy/Maven build output that may still sit on developer
# machines after the rewrite. The sources themselves live under
# retired/ and ARE versioned.
target/
.classpath
.project
.apt_generated/
.apt_generated_tests/
.mvn/wrapper/maven-wrapper.jar

# Terraform state (only relevant for legacy scripts under retired/)
*.tfstate
*.tfstate.*
*.lock.hcl
**/.terraform/*
